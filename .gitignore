# Environments & virtualenvs
.venv/
venv/
.env
.env.*
!.env.example

# Credentials & secrets protection
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
id_rsa*
*.pub

# Python cache & test artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend build artifacts
node_modules/
frontend/dist/

# Logs & Editor configs
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Databases & local stores
*.sqlite
*.sqlite3
*.db

# ML datasets & checkpoints
dataset/
models/*
!models/.gitkeep
*.pkl
*.pth
*.pt

# Proofly local analysis artifacts (may contain extracted document text)
backend/analysis_results/

# Runtime uploads: ignore all contents except harmless .gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Temporary outputs
outputs/test-tmp/
outputs/proofly_synthetic/
outputs/proofly_smoke/
outputs/proofly_smoke_check.py
